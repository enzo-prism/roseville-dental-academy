          "value": 0,
          "unit": "px"
        }
      }
    },
    "heading-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fjalla One, Arial, sans-serif",
        "fontSize": {
          "value": 42,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "heading-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fjalla One, Arial, sans-serif",
        "fontSize": {
          "value": 26,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "nav-label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fjalla One, Arial, sans-serif",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "utility-label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fjalla One, Arial, sans-serif",
        "fontSize": {
          "value": 13,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
