    "accent-deep": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.478,
          0.333,
          0.141
        ],
        "hex": "#7a5524"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.788,
          0.788,
          0.788
        ],
        "hex": "#c9c9c9"
      }
    },
    "border-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.898,
          0.882,
          0.863
        ],
        "hex": "#e5e1dc"
      }
    }
