{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A faithful, restrained GoDaddy-style design contract for the Roseville Dental Academy production-ready Next.js rebuild.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.192,
          0.337,
          0.345
        ],
        "hex": "#315658"
      }
    },
    "primary-deep": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.141,
          0.282,
          0.29
        ],
        "hex": "#24484a"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.169,
          0.169,
          0.169
        ],
        "hex": "#2b2b2b"
      }
    },
    "heading": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
