          0.4,
          0.4
        ],
        "hex": "#666666"
      }
    },
    "subnav-text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.314,
          0.314,
          0.314
        ],
        "hex": "#505050"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.549,
          0.392,
          0.176
        ],
        "hex": "#8c642d"
      }
    },
    "accent-active": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.718,
