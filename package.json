{
  "name": "roseville",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib tests next.config.ts postcss.config.mjs",
    "audit:design": "node scripts/design-audit.mjs",
    "design:lint": "design.md lint DESIGN.md",
    "design:sync": "node scripts/sync-design-tokens.mjs",
    "design:check": "pnpm design:lint && pnpm design:sync",
    "attribution:migrate": "node scripts/migrate-attribution.mjs",
    "test:attribution-db": "node scripts/verify-attribution-migration.mjs",
    "snapshot:refresh": "node scripts/capture-live-snapshot.mjs && node scripts/refresh-live-baselines.mjs",
    "test:smoke": "BASELINE_DIR=${BASELINE_DIR:-tests/baselines/live} LOCAL_ORIGIN=${LOCAL_ORIGIN:-http://127.0.0.1:3000} playwright test tests/smoke.spec.ts",
    "test:interactions": "BASELINE_DIR=${BASELINE_DIR:-tests/baselines/live} LOCAL_ORIGIN=${LOCAL_ORIGIN:-http://127.0.0.1:3000} playwright test tests/interaction-flow.spec.ts",
    "test:attribution": "BASELINE_DIR=${BASELINE_DIR:-tests/baselines/live} LOCAL_ORIGIN=${LOCAL_ORIGIN:-http://127.0.0.1:3000} playwright test tests/attribution-api.spec.ts",
    "test:parity-content": "BASELINE_DIR=${BASELINE_DIR:-tests/baselines/live} LOCAL_ORIGIN=${LOCAL_ORIGIN:-http://127.0.0.1:3000} playwright test tests/live-parity.spec.ts",
    "test:parity-visual": "BASELINE_DIR=${BASELINE_DIR:-tests/baselines/live} LOCAL_ORIGIN=${LOCAL_ORIGIN:-http://127.0.0.1:3000} playwright test tests/live-parity.visual.spec.ts",
    "test:ux": "BASELINE_DIR=${BASELINE_DIR:-tests/baselines/live} LOCAL_ORIGIN=${LOCAL_ORIGIN:-http://127.0.0.1:3000} playwright test tests/ux-stability.spec.ts",
    "test:design": "pnpm test:ux && pnpm test:parity-visual",
    "test:parity": "pnpm test:parity-content && pnpm test:parity-visual",
    "test:release": "pnpm lint && pnpm build && PLAYWRIGHT_SERVER_MODE=prod LOCAL_ORIGIN=${LOCAL_ORIGIN:-http://127.0.0.1:3100} pnpm test:smoke && PLAYWRIGHT_SERVER_MODE=prod LOCAL_ORIGIN=${LOCAL_ORIGIN:-http://127.0.0.1:3100} pnpm test:parity-content && PLAYWRIGHT_SERVER_MODE=prod LOCAL_ORIGIN=${LOCAL_ORIGIN:-http://127.0.0.1:3100} pnpm test:ux && PLAYWRIGHT_SERVER_MODE=prod LOCAL_ORIGIN=${LOCAL_ORIGIN:-http://127.0.0.1:3100} pnpm test:parity-visual",
    "test:preview": "PREVIEW_URL=${PREVIEW_URL:?PREVIEW_URL is required} PLAYWRIGHT_NO_WEBSERVER=1 LOCAL_ORIGIN=${PREVIEW_URL} pnpm test:smoke && PREVIEW_URL=${PREVIEW_URL:?PREVIEW_URL is required} PLAYWRIGHT_NO_WEBSERVER=1 LOCAL_ORIGIN=${PREVIEW_URL} pnpm test:parity-content && PREVIEW_URL=${PREVIEW_URL:?PREVIEW_URL is required} PLAYWRIGHT_NO_WEBSERVER=1 LOCAL_ORIGIN=${PREVIEW_URL} pnpm test:ux && PREVIEW_URL=${PREVIEW_URL:?PREVIEW_URL is required} PLAYWRIGHT_NO_WEBSERVER=1 LOCAL_ORIGIN=${PREVIEW_URL} pnpm test:parity-visual"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@google/design.md": "0.1.1",
    "@playwright/test": "^1.59.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.59.0",
    "shadcn": "^4.1.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
